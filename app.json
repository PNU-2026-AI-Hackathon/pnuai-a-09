{
  "expo": {
    "name": "whale-app",
    "slug": "whale-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/whale1.png",
    "scheme": "whaleapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.whaledone.myapp",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.whaledone.myapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/whale1.png",
        "backgroundImage": "./assets/icons/whale1.png",
        "monochromeImage": "./assets/icons/whale1.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
      
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21" 
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "19be534e574dc7e8d8b3b3f7b8a8306f"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "701c2a7e-65cf-47d7-b6ed-3d3da2b9c7b9"
      }
    }
  }
}
